html
 head 
  include pug/layout/meta.pug
  include pug/layout/styles.pug
 body.position-relative 
    include pug/layout/navbar.pug
    include pug/components/up.pug
    section.section.product
     .container
       #creative-prod.w-75.m-auto
             .entry-thumbnail-area.mb-2
                img(src="images/blog2.jpg", alt="").img-fluid
             .entry-header
