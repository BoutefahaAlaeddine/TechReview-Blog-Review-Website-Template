section.section.categories
 .container
   h2.h1.title Editor's Choice
   ul.d-flex.justify-content-end.list-unstyled.filter-menu
     li(data-target='all').current All
     li(data-target='male') Male
     li(data-target='female') Female
     li(data-target='kid') Kid
   ul.row.list-unstyled.filter-item
    li.col-lg-4(data-item='kid')
       .card.bg-dark.text.position-relative
          .img-scale 
            a(href="#") 
              img.img-fluid(src='images/blog1.jpg' alt='')
              .card-img-overlay
          .card-info.position-absolute
            .card-body
                  div.d-flex.align-items-center.mb-4
                    a.btn.btn-orange-2.me-2(href='#') Creative
                    div(data-rating=4.7).d-inline.stars.me-1
                    span.rating 5/5
                  a(href="#").card-title
                      | Cheap Smart Phone Could And Help You Old Food Safe  
                  p.card-text
                      span.name.me-2  By Admin 
                      span.date  September 15, 2022
                      span.views.d-block Views 5331     
              
